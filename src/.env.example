# ------------------------------------------------------------------
# Contact form (SMTP via Nodemailer + Gmail) — server-side only.
# NEVER prefix these with VITE_ — that would leak them into the browser bundle.
# Fill real values in `.env.local` (gitignored). This file has placeholders only.
# ------------------------------------------------------------------
# Gmail SMTP transport (defaults work for Gmail; usually no need to change)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Your Gmail address that SENDS the mail (must match the App Password account)
SMTP_USER=you@gmail.com

# Google App Password (16 chars, NOT your normal Gmail password — see setup guide)
SMTP_PASS=xxxx-xxxx-xxxx-xxxx

# Inbox that RECEIVES contact messages (can be the same Gmail address)
CONTACT_TO_EMAIL=you@gmail.com

# Local dev API port (Express server in server.ts). Keep 3001 unless taken.
CONTACT_API_PORT=3001

# ------------------------------------------------------------------
# Legacy / optional vars (kept for other features; not used by contact form)
# ------------------------------------------------------------------
# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
